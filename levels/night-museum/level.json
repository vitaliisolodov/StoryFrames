      "frame": 2,
      "setting": "hall",
      "characters": [
        "guard"
      ],
      "text": "Петро позіхає й нічого не помічає."
    },
    {
      "frame": 2,
      "setting": "hall",
      "characters": [
        "cat"
      ],
      "text": "Кіт Мур стежить за кимось у темряві."
    },
    {
      "frame": 3,
      "setting": "vault",
      "characters": [
        "thief"
      ],
      "text": "Діамант «Північна зоря» лежить на оксамиті. Лишилося простягнути руку."
    },
    {
      "frame": 3,
      "setting": "vault",
      "characters": [
        "thief",
        "guard"
      ],
      "text": "Промінь ліхтаря: «Стояти!»"
    },
    {
      "frame": 3,
      "setting": "vault",
      "characters": [
        "thief",
        "cat"
      ],
      "text": "Мур муркоче просто над вухом злодійки… і дзвіночок видає її."
    },
    {
      "frame": 3,
      "setting": "vault",
      "characters": [
        "cat"
      ],
      "text": "Мур обережно тягне лапою блискучу цяцьку."
    },
    {
      "frame": 3,
      "setting": "vault",
      "characters": [
        "curator",
        "thief"
      ],
      "text": "«Ви запізнилися на п’ять хвилин», — каже пані куратор."
    },
    {
      "frame": 3,
      "setting": "lobby",
      "characters": [
        "guard"
      ],
      "text": "Петро дрімає за стійкою. Усе ж спокійно."
    },
    {
      "frame": 4,
      "setting": "hall",
      "characters": [
        "ghost",
        "thief"
      ],
      "text": "Зі стіни виходить привид. Мара забула, як бігти."
    },
    {
      "frame": 4,
      "setting": "vault",
      "characters": [
        "thief"
      ],
      "text": "Лазерні промені гаснуть один за одним."
    },
    {
      "frame": 5,
      "setting": "roof",
      "characters": [
        "thief"
      ],
      "text": "На даху світанок, вітер і жодних слідів."
    },
    {
      "frame": 5,
      "setting": "roof",
      "characters": [
        "cat"
      ],
      "text": "Кіт сидить на даху з діамантом і не збирається ділитися."
    },
    {
      "frame": 5,
      "setting": "roof",
      "characters": [
        "curator",
        "thief"
      ],
      "text": "Двоє на даху ділять здобич. Музей так і не дізнається."
    },
    {
      "frame": 5,
      "setting": "lobby",
      "characters": [
        "guard",
        "thief"
      ],
      "text": "Наручники клацають під першими променями сонця."
    },
    {
      "frame": 5,
      "setting": "lobby",
      "characters": [
        "guard",
        "cat"
      ],
      "text": "Петро вдячно чухає кота за вухом."
    },
    {
      "frame": 5,
      "setting": "lobby",
      "characters": [
        "ghost"
      ],
      "text": "Музей мовчить. Тепер це знову його домівка."
    },
    {
      "frame": 5,
      "setting": "office",
      "characters": [
        "curator",
        "guard"
      ],
      "text": "Пані куратор приймає звіт: «Ніч минула спокійно»."
    }
